# ==============================================================================
# BACKEND API & SIGNALING SERVER CONFIGURATION TEMPLATE (.env.example)
# Copy this file to server/.env.local or server/.env for local development.
# Do NOT place real secrets in this template.
# ==============================================================================

# Server Environment Mode ('development', 'staging', or 'production')
NODE_ENV=development

# Server Port (default: 5000; dynamically falls back to 5001+ if in use)
PORT=5000

# Trusted Frontend Origin for CORS validation
FRONTEND_URL=http://localhost:3000

# MongoDB Connection String (e.g., mongodb://localhost:27017/youtube_clone or Atlas SRV)
DB_URL=mongodb://localhost:27017/youtube_clone

# JWT Authentication Secret and Token Expiry
JWT_SECRET=replace_with_a_secure_random_string_in_production
JWT_EXPIRES_IN=7d

# Refresh Token Configuration (Optional / Future Multi-tier Token Rotation)
REFRESH_TOKEN_SECRET=replace_with_refresh_token_secret_in_production
REFRESH_TOKEN_EXPIRES_IN=30d

# OTP Verification Configuration (Phase 7)
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_WINDOW_MINUTES=15
OTP_MAX_REQUESTS_PER_WINDOW=3

# Trusted Device Security Configuration (Phase 8)
TRUSTED_DEVICE_EXPIRY_DAYS=30

# Session Management Configuration (Phase 9)
SESSION_EXPIRY_DAYS=7
MAX_ACTIVE_SESSIONS_PER_USER=10

# Communication & Notification Services (Email / SMS)
EMAIL_SERVICE=mock
EMAIL_FROM=noreply@youtube-clone.local
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMS_SERVICE=mock
SMS_API_KEY=

# Timezone Configuration for Automatic Theme Resolution (Phase 2)
APP_TIMEZONE=Asia/Kolkata

# LiveKit SFU Credentials for Video/Audio Token Generation
LIVEKIT_URL=wss://youtube-yn47nbsb.livekit.cloud
LIVEKIT_API_KEY=replace_with_livekit_api_key
LIVEKIT_API_SECRET=replace_with_livekit_api_secret

# Storage Configurations
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
RECORDING_DIR=uploads/recordings
MAX_ATTACHMENT_SIZE_MB=25
MAX_RECORDING_SIZE_MB=500
MAX_RECORDING_DURATION_MINUTES=180
RECORDING_SIGNED_URL_EXPIRY=3600
