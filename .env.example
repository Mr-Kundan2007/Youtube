# ==============================================================================
# SECURE VIDEO PLATFORM & SUBSCRIPTION MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env or .env.local and populate with your production credentials.
# NEVER commit production secrets or real credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & NETWORK CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=5001
FRONTEND_URL=https://your-domain.com

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MONGODB)
# ------------------------------------------------------------------------------
# MongoDB connection URI (e.g. MongoDB Atlas replica set or self-hosted)
DB_URL=mongodb+srv://<username>:<password>@<cluster-host>/youtube?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & CRYPTOGRAPHY
# ------------------------------------------------------------------------------
# HMAC-SHA256 secret key for signing user authentication JSON Web Tokens (min 32 chars)
JWT_SECRET=your_super_secret_jwt_hmac_key_min_32_chars
JWT_EXPIRES_IN=7d

# Cryptographic secret for signing single-use download tokens & signed streaming URLs
DOWNLOAD_TOKEN_SECRET=your_super_secret_download_token_hmac_key_min_32_chars
DOWNLOAD_TOKEN_EXPIRY=600
SIGNED_URL_TTL=300

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAY (RAZORPAY INTEGRATION)
# ------------------------------------------------------------------------------
# For development/staging, use keys prefixed with rzp_test_
# For production, use keys prefixed with rzp_live_
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretKeyHere
RAZORPAY_WEBHOOK_SECRET=YourRazorpayWebhookSecretHere
SUBSCRIPTION_CURRENCY=INR

# ------------------------------------------------------------------------------
# 5. SUBSCRIPTION & BILLING POLICIES
# ------------------------------------------------------------------------------
GRACE_PERIOD_DAYS=3
RENEWAL_REMINDER_DAYS_BEFORE=3,1
SUBSCRIPTION_CACHE_TTL_SECONDS=300

# Tax & Corporate Billing Information
COMPANY_NAME="Video Streaming Platforms Pvt Ltd"
COMPANY_GSTIN="27ABCDE1234F1Z5"
COMPANY_ADDRESS="Tech Park, Cyber Hub, Bengaluru, Karnataka, India"
COMPANY_SAC_CODE="998439"
TAX_PERCENTAGE=18

# ------------------------------------------------------------------------------
# 6. DOWNLOAD QUOTAS & TIER LIMITS
# ------------------------------------------------------------------------------
DOWNLOAD_LIMIT_FREE=1
DOWNLOAD_LIMIT_BRONZE=5
DOWNLOAD_LIMIT_SILVER=15
DOWNLOAD_LIMIT_GOLD=50

DOWNLOAD_DUPLICATE_WINDOW_HOURS=24
DOWNLOAD_MAX_RETRIES=3
DOWNLOAD_RETRY_WINDOW_MINUTES=60
DOWNLOAD_HISTORY_MAX_LIMIT=50

# Device Restrictions & Quotas
DOWNLOAD_DEVICE_RESTRICTIONS=true
DOWNLOAD_DEVICE_BINDING_ENABLED=true
DEVICE_REPLACEMENT_COOLDOWN_HOURS=24
MAX_CONCURRENT_DOWNLOADS_PER_DEVICE=1
DEVICE_ACTIVITY_UPDATE_INTERVAL=300

# ------------------------------------------------------------------------------
# 7. RATE LIMITING, CIRCUIT BREAKERS & ABUSE MITIGATION
# ------------------------------------------------------------------------------
DOWNLOAD_RATE_LIMIT_MAX=20
DOWNLOAD_RATE_LIMIT_USER_PER_MINUTE=20
DOWNLOAD_RATE_LIMIT_DEVICE_PER_MINUTE=20
DOWNLOAD_RATE_LIMIT_IP_PER_MINUTE=60
DOWNLOAD_FAILED_LIMIT_PER_MINUTE=5
DOWNLOAD_TOKEN_FAILURE_LIMIT_PER_MINUTE=5

CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=30000

RISK_SCORE_DECAY_HOURS=24
TEMP_RESTRICTION_MINUTES=30
RAPID_DEVICE_SWITCH_WINDOW_MINUTES=10
RAPID_DEVICE_SWITCH_LIMIT=3
RAPID_IP_CHANGE_WINDOW_MINUTES=10
RAPID_IP_CHANGE_LIMIT=3

# ------------------------------------------------------------------------------
# 8. STORAGE & MEDIA DELIVERY
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
RECORDING_DIR=uploads/recordings
DOWNLOAD_PRIVATE_DIR=storage/private/videos
MAX_ATTACHMENT_SIZE_MB=25
MAX_RECORDING_SIZE_MB=500
MAX_RECORDING_DURATION_MINUTES=180
RECORDING_SIGNED_URL_EXPIRY=3600

# ------------------------------------------------------------------------------
# 9. LIVEKIT VIDEO COLLABORATION (OPTIONAL / PRODUCTION)
# ------------------------------------------------------------------------------
VIDEO_PROVIDER=livekit
LIVEKIT_URL=https://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ------------------------------------------------------------------------------
# 10. FRONTEND NEXT.JS PUBLIC CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SERVER_URL=https://api.your-domain.com
NEXT_PUBLIC_API_URL=https://api.your-domain.com
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere

# Firebase Authentication (Google Auth Provider)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-app.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# ------------------------------------------------------------------------------
# 11. HTML5 VIDEO PLAYER & ANALYTICS CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_ANALYTICS_ENABLED=true
NEXT_PUBLIC_ENABLE_DEBUG=false
ANALYTICS_RATE_LIMIT=120
PROGRESS_SYNC_INTERVAL=15

# ------------------------------------------------------------------------------
# 12. MULTILINGUAL COMMENTING SYSTEM & THREADING (PHASES 1-6)
# ------------------------------------------------------------------------------
# Time window for editing comments before changes are locked (in minutes)
COMMENT_EDIT_WINDOW_MINUTES=15
# Time window for soft-deleting comments (0 = anytime by owner or moderator)
COMMENT_DELETE_WINDOW_MINUTES=0
# Threading limits
COMMENT_MAX_LENGTH=2000
COMMENT_MAX_REPLY_DEPTH=3
COMMENT_DEFAULT_PAGE_SIZE=20
COMMENT_MAX_PAGE_SIZE=50

# ------------------------------------------------------------------------------
# 13. CONTENT SAFETY, PROFANITY & ANTI-ABUSE (PHASE 8)
# ------------------------------------------------------------------------------
ENABLE_PROFANITY_FILTER=true
ENABLE_SPAM_DETECTION=true
ENABLE_DUPLICATE_DETECTION=true
ENABLE_LINK_SAFETY=true
ENABLE_EMOJI_ABUSE_DETECTION=true
ENABLE_FLOODING_DETECTION=true
COMMENT_DUPLICATE_WINDOW_SECONDS=60
PROFANITY_THRESHOLD=0.7

# ------------------------------------------------------------------------------
# 14. MULTILINGUAL TRANSLATION & CACHING (PHASE 7)
# ------------------------------------------------------------------------------
# Translation provider: 'internal' (dictionary heuristics) or 'google' (Google Cloud Translation)
TRANSLATION_PROVIDER=internal
TRANSLATION_API_KEY=your_google_cloud_translation_api_key_here
TRANSLATION_TIMEOUT_MS=8000
TRANSLATION_CACHE_TTL_DAYS=30

# ------------------------------------------------------------------------------
# 15. RATE LIMITING, CAPTCHA & MODERATION (PHASES 9-11)
# ------------------------------------------------------------------------------
# Storage: 'memory' (in-process) or 'redis' (production cluster)
RATE_LIMIT_STORAGE=memory
REDIS_URL=redis://default:your_redis_password@127.0.0.1:6379

# CAPTCHA verification (Cloudflare Turnstile or Google reCAPTCHA v2/v3)
CAPTCHA_PROVIDER=mock
CAPTCHA_SECRET_KEY=your_turnstile_or_recaptcha_secret_key
NEXT_PUBLIC_CAPTCHA_PROVIDER=mock
NEXT_PUBLIC_CAPTCHA_SITE_KEY=your_turnstile_or_recaptcha_site_key


