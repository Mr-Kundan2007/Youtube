{
  "name": "youtube",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k npm:dev:next npm:dev:server",
    "dev:next": "next dev",
    "dev:server": "node server/index.js",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:server": "cd server && npm test",
    "test:theme": "node server/tests/phase2_theme_system.test.js",
    "test:theme:persistence": "node server/tests/phase3_persistent_theme.test.js",
    "test:device": "node server/tests/phase4_device_detection.test.js",
    "test:location": "node server/tests/phase5_ip_location.test.js",
    "test:detection": "node server/tests/phase6_new_login_detection.test.js",
    "test:otp": "node server/tests/phase7_otp_verification.test.js",
    "test:trusted": "node server/tests/phase8_trusted_device_history.test.js",
    "test:session": "node server/tests/phase9_active_sessions.test.js",
    "test:alerts": "node server/tests/phase10_security_alerts.test.js",
    "test:comment:phase1": "node server/tests/phase1_comment_inspection.test.js",
    "test:comment:phase2": "node server/tests/phase2_comment_database.test.js",
    "test:comment:phase3": "node server/tests/phase3_comment_core.test.js",
    "test:comment:phase4": "node server/tests/phase4_replies_threading.test.js",
    "test:comment:phase5": "node server/tests/phase5_reactions_mentions.test.js",
    "test:comment:phase6": "node server/tests/phase6_edit_delete_history.test.js",
    "test:comment:phase7": "node server/tests/phase7_multilingual_translation.test.js",
    "test:comment:phase8": "node server/tests/phase8_content_safety.test.js",
    "test:comment:phase9": "node server/tests/phase9_rate_limiting_captcha.test.js",
    "test:comment:phase10": "node server/tests/phase10_reporting_moderation.test.js",
    "test:comment:phase11": "node server/tests/phase11_sorting_performance_security.test.js",
    "test:comment:phase12": "node server/tests/phase12_master_comment_system.test.js",
    "check:comment:readiness": "node server/scripts/verifyCommentSystemReadiness.js --allow-offline",
    "check:comment:readiness:strict": "node server/scripts/verifyCommentSystemReadiness.js",
    "test:all": "cd server && npm run test:all",
    "test:phase11": "node server/tests/phase11_master_runner.js",
    "test:e2e": "node server/tests/phase12_subscription_system_e2e.test.js",
    "test:player": "node server/tests/phase1_custom_videoplayer.test.js",
    "test:all:phases": "npm run test:phase11 && npm run test:e2e",
    "check:readiness": "node server/scripts/preDeploymentCheck.js",
    "report:readiness": "node server/scripts/generateReadinessReport.js"
  },
  "dependencies": {
    "@livekit/components-react": "^2.9.24",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-slot": "^1.3.3",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "firebase": "^12.18.0",
    "livekit-client": "^2.22.2",
    "lucide-react": "^1.39.0",
    "mongodb": "^7.6.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
